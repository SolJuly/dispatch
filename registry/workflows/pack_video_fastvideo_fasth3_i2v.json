{
  "description": "FastH3 加速版，单图出短视频。输入：首帧图 + 提示词；输出：MP4。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "ext": "mp4",
    "min_bytes": 50000
  },
  "fps": 24,
  "graph": "workflows/pack/video_fastvideo_fasth3_i2v.api.json",
  "key": "pack_video_fastvideo_fasth3_i2v",
  "kind": "video",
  "limits": {
    "max_cost": 1.6,
    "max_minutes": 40
  },
  "model": {
    "key": "fastvideo_fasth3_8step_v2_pruned_int",
    "slots": {
      "clip": {
        "input": "clip_name",
        "node": "1153"
      },
      "unet": {
        "input": "unet_name",
        "node": "1152"
      },
      "vae": {
        "input": "vae_name",
        "node": "1144"
      },
      "vae_2": {
        "input": "vae_name",
        "node": "1145"
      }
    }
  },
  "name": "图生视频 · FastH3 8 步（快）",
  "notes": "官方模板导入，未本地真机验证（compat=experimental）",
  "output": {
    "ext": "mp4",
    "input": "filename_prefix",
    "kind": "video",
    "node": "92",
    "pick": [
      "videos",
      "gifs"
    ]
  },
  "params": {
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "136"
        }
      ],
      "description": "主输入图。人脸/人物类工作流用它当身份或首帧来源。",
      "required": true,
      "type": "image"
    },
    "prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "1156"
        }
      ],
      "default": "For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully re…",
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "seed": {
      "bindings": [
        {
          "input": "noise_seed",
          "node": "1154"
        }
      ],
      "default": 0,
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "max": 2147483647,
      "min": 0,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
