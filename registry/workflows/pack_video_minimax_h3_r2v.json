      "type": "image"
    },
    "prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "136"
        }
      ],
      "default": "Bold comic-book ink style, heavy linework, red and blue-black palette, night city. Use <Picture 2> a…",
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "seed": {
      "bindings": [
