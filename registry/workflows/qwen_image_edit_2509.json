{
  "description": "按中英文指令改图（换背景/改风格/加删元素），4 步 Lightning。输入：底图 + 指令；输出：1024 PNG。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "black_ratio_max": 0.5,
    "ext": "png",
    "images": 1,
    "min_bytes": 20000
  },
  "graph": "workflows/qwen_image_edit_2509.api.json",
  "key": "qwen_image_edit_2509",
  "kind": "image",
  "limits": {
    "max_cost": 1.2,
    "max_minutes": 20
  },
  "model": {
    "key": "qwen_image_edit_2509",
    "slots": {
      "clip": {
        "input": "clip_name",
        "node": "7"
      },
      "unet": {
        "input": "unet_name",
        "node": "3"
      },
      "vae": {
        "input": "vae_name",
        "node": "8"
      }
    }
  },
  "name": "指令改图 · Qwen-Image-Edit 2509（4 步）",
  "notes": "Qwen-Image-Edit 2509：LoadImage → FluxKontextImageScale → VAEEncode + TextEncodeQwenImageEditPlus(prompt, image1) → KSampler(4 步 Lightning) → 单图。24G 4090 实测通过（背景换雪景、人物保持）。",
  "output": {
    "count": 1,
    "ext": "png",
    "input": "filename_prefix",
    "kind": "image",
    "node": "14",
    "pick": [
      "images"
    ]
  },
  "params": {
    "cfg": {
      "bindings": [
        {
          "input": "cfg",
          "node": "12"
        }
      ],
      "default": 1.0,
      "description": "提示词遵从度（CFG scale）。低（1-2）= 更自由、更贴合输入素材；高（7+）= 更严格按提示词来，但容易僵硬或过饱和。改图/动作迁移类建议留在低位。",
      "max": 4.0,
      "min": 0.5,
      "type": "float"
    },
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "1"
        }
      ],
      "description": "待编辑的图片；内部用 FluxKontextImageScale 缩放到约 1MP",
      "required": true,
      "type": "image"
    },
    "negative_prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "10"
        }
      ],
      "default": "",
      "description": "负向提示词：不想出现的内容。与 neg_prompt 同义，不同工作流的字段命名习惯不同而已。",
      "type": "string"
    },
    "prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "9"
        }
      ],
      "description": "编辑指令，例如“把背景换成夜晚的雪景街道，人物保持不变”",
      "required": true,
      "type": "string"
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "12"
        }
      ],
      "default": 42,
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "type": "int"
    },
    "steps": {
      "bindings": [
        {
          "input": "steps",
          "node": "12"
        }
      ],
      "default": 4,
      "description": "配 Lightning LoRA 用 4 步；去掉 LoRA 时要调到 20+",
      "max": 8,
      "min": 2,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
