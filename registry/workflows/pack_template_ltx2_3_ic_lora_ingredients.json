{
  "description": "用参考素材 + IC-LoRA 控制视频风格。输入：参考图 + 提示词；输出：MP4。缺模型文件。（🚧 尚未开发）",
  "engine": "comfyui",
  "expect_defaults": {
    "duration_s": [
      1.0,
      120.0
    ],
    "ext": "mp4",
    "min_bytes": 50000
  },
  "graph": "workflows/pack/template_ltx2_3_ic_lora_ingredients.api.json",
  "key": "pack_template_ltx2_3_ic_lora_ingredients",
  "kind": "video",
  "limits": {
    "max_cost": 1.6,
    "max_minutes": 40
  },
  "model": {
    "key": "ltx_2_3_22b_distilled_fp8",
    "slots": {
      "ckpt": {
        "input": "ckpt_name",
        "node": "1741"
      },
      "lora": {
        "input": "lora_name",
        "node": "1744"
      },
      "lora_2": {
        "input": "lora_name",
        "node": "1747"
      }
    }
  },
  "name": "素材驱动视频 · LTX 2.3 IC-LoRA（尚未开发）",
  "notes": "官方模板导入，未本地真机验证（compat=experimental）",
  "output": {
    "ext": "mp4",
    "input": "filename_prefix",
    "kind": "video",
    "node": "68",
    "pick": [
      "videos",
      "gifs"
    ]
  },
  "params": {
    "height": {
      "bindings": [
        {
          "input": "height",
          "node": "1727"
        }
      ],
      "default": 704,
      "description": "输出高度（像素）。与宽度配套调整，保持原始素材的宽高比。",
      "max": 2048,
      "min": 256,
      "multiple": 32,
      "type": "int"
    },
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "724"
        }
      ],
      "description": "主输入图。人脸/人物类工作流用它当身份或首帧来源。",
      "required": true,
      "type": "image"
    },
    "neg_prompt": {
      "bindings": [
        {
          "input": "text",
          "node": "1735"
        }
      ],
      "default": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, g…",
      "description": "负向提示词：不想出现的东西。默认值是一套通用的避坑词（防手部畸形、画面静止、糊、水印等），没有特殊需求就保持原样。",
      "required": false,
      "type": "string"
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "1752"
        }
      ],
      "default": 0,
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "max": 2147483647,
      "min": 0,
      "type": "int"
    },
    "width": {
      "bindings": [
        {
          "input": "width",
          "node": "1727"
        }
      ],
      "default": 1280,
      "description": "输出宽度（像素）。越大越清晰但越慢越贵；改完后高度要按同样的比例缩放，否则画面会被拉变形。",
      "max": 2048,
      "min": 256,
      "multiple": 32,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
