{
 "schema": "p20.workflow/v1",
 "key": "sdxl_t2i_lora",
 "name": "文生图 + 风格 LoRA · SDXL（厚涂）",
 "description": "带厚涂风格 LoRA 的 SDXL 出图。输入：提示词；输出：1024 PNG。（✅ 可使用）",
 "version": 1,
 "kind": "image",
 "engine": "comfyui",
 "graph": "workflows/sdxl_t2i_lora.api.json",
 "model": {
  "key": "sdxl_juggernaut",
  "slots": {
   "ckpt": {
    "node": "ckpt",
    "input": "ckpt_name"
   }
  }
 },
 "params": {
  "seed": {
   "type": "int",
   "required": true,
   "bindings": [
    {
     "node": "ks",
     "input": "seed"
    }
   ]
  },
  "steps": {
   "type": "int",
   "default": 25,
   "min": 1,
   "max": 60,
   "bindings": [
    {
     "node": "ks",
     "input": "steps"
    }
   ]
  },
  "cfg": {
   "type": "float",
   "default": 6.0,
   "min": 0.0,
   "max": 30.0,
   "bindings": [
    {
     "node": "ks",
     "input": "cfg"
    }
   ]
  },
  "sampler": {
   "type": "enum",
   "default": "dpmpp_2m",
   "values": [
    "euler",
    "euler_ancestral",
    "dpmpp_2m",
    "dpmpp_2m_sde",
    "uni_pc"
   ],
   "bindings": [
    {
     "node": "ks",
     "input": "sampler_name"
    }
   ]
  },
  "scheduler": {
   "type": "enum",
   "default": "karras",
   "values": [
    "simple",
    "normal",
    "karras",
    "beta"
   ],
   "bindings": [
    {
     "node": "ks",
     "input": "scheduler"
    }
   ]
  },
  "prompt": {
   "type": "string",
   "required": true,
   "bindings": [
    {
     "node": "pos",
     "input": "text"
    }
   ]
  },
  "neg_prompt": {
   "type": "string",
   "default": "blurry, lowres, watermark",
   "bindings": [
    {
     "node": "neg",
     "input": "text"
    }
   ]
  },
  "width": {
   "type": "int",
   "default": 1024,
   "min": 512,
   "max": 1536,
   "multiple": 8,
   "bindings": [
    {
     "node": "lat",
     "input": "width"
    }
   ]
  },
  "height": {
   "type": "int",
   "default": 1024,
   "min": 512,
   "max": 1536,
   "multiple": 8,
   "bindings": [
    {
     "node": "lat",
     "input": "height"
    }
   ]
  },
  "batch_size": {
   "type": "int",
   "default": 1,
   "min": 1,
   "max": 4,
   "bindings": [
    {
     "node": "lat",
     "input": "batch_size"
    }
   ]
  },
  "lora": {
   "type": "string",
   "required": true,
   "default": "Sdxl/绪儿_厚涂构图光影质感增强V3.safetensors",
   "bindings": [
    {
     "node": "lora",
     "input": "lora_name"
    }
   ],
   "description": "LoRA 文件名（相对 models/loras）"
  },
  "lora_strength": {
   "type": "float",
   "default": 0.8,
   "min": 0.0,
   "max": 1.5,
   "bindings": [
    {
     "node": "lora",
     "input": "strength_model"
    },
    {
     "node": "lora",
     "input": "strength_clip"
    }
   ]
  }
 },
 "output": {
  "node": "save",
  "input": "filename_prefix",
  "kind": "image",
  "ext": "png",
  "pick": [
   "images"
  ]
 },
 "expect_defaults": {
  "ext": "png",
  "min_bytes": 20000,
  "black_ratio_max": 0.5
 },
 "limits": {
  "max_minutes": 20,
  "max_cost": 0.8
 },
 "required_gpu": [
  "4090",
  "4090_48G"
 ],
 "notes": "P2.1 5.4：LoraLoader 插在 ckpt 与采样器之间；lora 文件名来自 M0 盘点（loras/Sdxl）。",
 "deprecated": true,
 "deprecated_reason": "P2.2 起由 zimage_turbo_t2i_hq 替换；仅保留供历史作业复现/回滚，控制台不再展示"
}