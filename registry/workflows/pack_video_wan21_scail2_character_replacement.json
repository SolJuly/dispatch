      "bindings": [
        {
          "node": "1358",
          "input": "text"
        },
        {
          "node": "1403",
          "input": "text"
        }
      ],
      "default": "",
      "description": "负向提示词：不想出现的东西。这类工作流默认留空即可 —— 负向词写太强会让人物细节糊掉。",
      "required": false,
      "type": "string"
    },
    "prompt": {
      "bindings": [
        {
          "node": "1359",
          "input": "text"
        },
        {
          "node": "1404",
          "input": "text"
        }
      ],
      "default": "A young woman with dark hair tied in a neat high bun, with a few loose strands framing her face, is …",
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "length": {
      "type": "int",
      "default": 81,
      "min": 1,
      "max": 121,
      "description": "▸ 动作参考的采样窗口（每批取多少帧），默认 81 ≈ 5 秒 @16fps。\n\n这个数**不决定成片时长**——成片时长跟着你上传的驱动视频走。\n想让成片更短/更省，请改上面的「trim_seconds」。\n\n一般不用动。改小了可能截断动作，改大了多耗时间。",
      "bindings": [
        {
          "node": "1340",
          "input": "length"
        },
        {
          "node": "1382",
          "input": "length"
        }
      ]
    },
    "trim_seconds": {
      "type": "float",
      "default": 4,
      "min": 0,
      "max": 60,
      "description": "用视频的前 4 秒做参考（默认）。填 0 = 整条都用，会成倍变慢变贵。\n\n· 填 4（默认）：约 7~8 分钟、¥0.35。适合先试效果，或动作本来就短。\n· 填 0：整条都用。10 秒素材 ≈ 30 分钟 ¥1.2；超过约 13 秒会撞 40 分钟上限失败。\n· 填其他数：取前 N 秒。8 秒 ≈ 15 分钟 ¥0.62。\n\n⚠ 这个工作流的成片时长**跟着驱动视频走**：截 4 秒，成片大约就 4 秒；\n   想要更长成片就得多给素材、多等、多花钱，没有白拿的。\n   建议先用 4 秒确认效果对不对，再决定要不要加长。",
      "virtual": true
    }
  },
