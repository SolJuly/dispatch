{
 "schema": "p20.workflow/v1",
 "key": "seedvr2_3b_upscale_video",
 "name": "视频放大 · SeedVR2 3B（短边到 1080）",
 "description": "逐帧还原放大视频。输入：MP4；输出：1080p MP4。（✅ 可使用）",
 "version": 1,
 "kind": "video",
 "engine": "comfyui",
 "graph": "workflows/seedvr2_3b_upscale_video.api.json",
 "model": {
  "key": "seedvr2_3b",
  "slots": {
   "dit": {
    "node": "3",
    "input": "model"
   },
   "vae": {
    "node": "4",
    "input": "model"
   }
  }
 },
 "params": {
  "video": {
   "type": "string",
   "required": true,
   "bindings": [
    {
     "node": "1",
     "input": "file"
    }
   ],
   "description": "待放大视频（mp4），走 run.py 的 video 上传通道"
  },
  "resolution": {
   "type": "int",
   "default": 1080,
   "min": 480,
   "max": 2160,
   "bindings": [
    {
     "node": "5",
     "input": "resolution"
    }
   ],
   "description": "目标短边像素；1080 = 1080p"
  },
  "seed": {
   "type": "int",
   "default": 42,
   "bindings": [
    {
     "node": "5",
     "input": "seed"
    }
   ]
  },
  "batch_size": {
   "type": "int",
   "default": 5,
   "min": 1,
   "max": 21,
   "bindings": [
    {
     "node": "5",
     "input": "batch_size"
    }
   ],
   "description": "每批帧数，必须 4n+1（1/5/9/13…）；显存不够就调小"
  },
  "color_correction": {
   "type": "enum",
   "default": "lab",
   "values": [
    "lab",
    "wavelet",
    "wavelet_adaptive",
    "hsv",
    "adain",
    "none"
   ],
   "bindings": [
    {
     "node": "5",
     "input": "color_correction"
    }
   ]
  }
 },
 "output": {
  "node": "7",
  "input": "filename_prefix",
  "kind": "video",
  "ext": "mp4",
  "pick": [
   "images"
  ],
  "count": 1
 },
 "expect_defaults": {
  "ext": "mp4",
  "min_bytes": 50000
 },
 "limits": {
  "max_minutes": 40,
  "max_cost": 1.6
 },
 "required_gpu": [
  "4090",
  "4090_48G"
 ],
 "notes": "SeedVR2 3B 视频放大：LoadVideo → GetVideoComponents → SeedVR2VideoUpscaler(短边 1080, batch 5) → CreateVideo(保留 fps/音频) → SaveVideo(mp4)。768x512/73 帧实测 1620x1080、73 帧、24fps。"
}