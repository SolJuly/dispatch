{
  "description": "只改蒙版区域，其余保持。输入：底图 + 蒙版 + 提示词；输出：1024 PNG。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "black_ratio_max": 0.5,
    "ext": "png",
    "min_bytes": 20000
  },
  "graph": "workflows/sdxl_inpaint.api.json",
  "key": "sdxl_inpaint",
  "kind": "image",
  "limits": {
    "max_cost": 0.8,
    "max_minutes": 20
  },
  "model": {
    "key": "sdxl_juggernaut",
    "slots": {
      "ckpt": {
        "input": "ckpt_name",
        "node": "ckpt"
      }
    }
  },
  "name": "局部重绘 · SDXL（蒙版）",
  "notes": "P2.1 5.3：LoadImage(底图) + LoadImage(蒙版) → VAEEncodeForInpaint(grow_mask_by) → KSampler(denoise) → 解码。保留区由 latent 的 noise mask 保证；M3 首选 SDXL 版（资产确定），Qwen-Image-ControlNet-Inpainting 作为 P2.2 质量升级项。",
  "output": {
    "ext": "png",
    "input": "filename_prefix",
    "kind": "image",
    "node": "save",
    "pick": [
      "images"
    ]
  },
  "params": {
    "cfg": {
      "bindings": [
        {
          "input": "cfg",
          "node": "ks"
        }
      ],
      "default": 6.0,
      "description": "提示词遵从度（CFG scale）。低（1-2）= 更自由、更贴合输入素材；高（7+）= 更严格按提示词来，但容易僵硬或过饱和。改图/动作迁移类建议留在低位。",
      "max": 30.0,
      "min": 0.0,
      "type": "float"
    },
    "denoise": {
      "bindings": [
        {
          "input": "denoise",
          "node": "ks"
        }
      ],
      "default": 0.85,
      "description": "重绘强度；<1 时保留部分原纹理",
      "max": 1.0,
      "min": 0.3,
      "type": "float"
    },
    "grow_mask_by": {
      "bindings": [
        {
          "input": "grow_mask_by",
          "node": "enc"
        }
      ],
      "default": 24,
      "description": "蒙版外扩像素，避免接缝",
      "max": 64,
      "min": 0,
      "type": "int"
    },
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "img"
        }
      ],
      "description": "底图",
      "required": true,
      "type": "image"
    },
    "mask": {
      "bindings": [
        {
          "input": "image",
          "node": "msk"
        }
      ],
      "description": "蒙版 PNG：白色=重绘区域，黑色=保留",
      "required": true,
      "type": "image"
    },
    "neg_prompt": {
      "bindings": [
        {
          "input": "text",
          "node": "neg"
        }
      ],
      "default": "blurry, lowres, watermark",
      "description": "负向提示词：不想出现的东西。默认值是一套通用的避坑词（防手部畸形、画面静止、糊、水印等），没有特殊需求就保持原样。",
      "type": "string"
    },
    "prompt": {
      "bindings": [
        {
          "input": "text",
          "node": "pos"
        }
      ],
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "sampler": {
      "bindings": [
        {
          "input": "sampler_name",
          "node": "ks"
        }
      ],
      "default": "dpmpp_2m",
      "description": "采样器。不同采样器的风格倾向不同；没有特别理由就沿用默认值，换采样器可能让原本稳定的结果变得不可预期。",
      "type": "enum",
      "values": [
        "euler",
        "euler_ancestral",
        "dpmpp_2m",
        "dpmpp_2m_sde",
        "uni_pc"
      ]
    },
    "scheduler": {
      "bindings": [
        {
          "input": "scheduler",
          "node": "ks"
        }
      ],
      "default": "karras",
      "description": "噪声调度器。与采样器配合决定去噪节奏；默认值通常已针对该模型调过。",
      "type": "enum",
      "values": [
        "simple",
        "normal",
        "karras",
        "beta"
      ]
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "ks"
        }
      ],
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "required": true,
      "type": "int"
    },
    "steps": {
      "bindings": [
        {
          "input": "steps",
          "node": "ks"
        }
      ],
      "default": 25,
      "description": "采样步数。步数越多细节越好但线性变慢；蒸馏版模型（名字带 distilled / fast / 8 步）刻意用很少的步数换速度，不要随意调高。",
      "max": 60,
      "min": 1,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
