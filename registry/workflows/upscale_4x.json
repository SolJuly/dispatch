{
  "description": "传统超分，4 倍放大，快但不补细节。输入：1 张图；输出：4× PNG。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "black_ratio_max": 0.5,
    "ext": "png",
    "min_bytes": 200000
  },
  "graph": "workflows/upscale_4x.api.json",
  "key": "upscale_4x",
  "kind": "image",
  "limits": {
    "max_cost": 0.8,
    "max_minutes": 20
  },
  "model": {
    "key": "upscale_ultrasharp",
    "slots": {
      "up": {
        "input": "model_name",
        "node": "up"
      }
    }
  },
  "name": "放大 4× · UltraSharp",
  "notes": "P2.1 5.4：ImageUpscaleWithModel + 4x-UltraSharp；输出边长是输入的 4 倍。",
  "output": {
    "ext": "png",
    "input": "filename_prefix",
    "kind": "image",
    "node": "save",
    "pick": [
      "images"
    ]
  },
  "params": {
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "load"
        }
      ],
      "description": "主输入图。人脸/人物类工作流用它当身份或首帧来源。",
      "required": true,
      "type": "image"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
