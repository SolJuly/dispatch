      "min": 0,
      "type": "int"
    },
    "width": {
      "bindings": [
        {
          "input": "width",
          "node": "1708"
        }
      ],
      "default": 1280,
      "description": "输出宽度（像素）。越大越清晰但越慢越贵；改完后高度要按同样的比例缩放，否则画面会被拉变形。",
      "max": 2048,
      "min": 256,
      "multiple": 32,
      "type": "int"
