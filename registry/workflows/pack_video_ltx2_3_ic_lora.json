    },
    "neg_prompt": {
      "bindings": [
        {
          "input": "text",
          "node": "1716"
        }
      ],
      "default": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, g…",
      "description": "负向提示词：不想出现的东西。默认值是一套通用的避坑词（防手部畸形、画面静止、糊、水印等），没有特殊需求就保持原样。",
      "required": false,
      "type": "string"
    },
    "prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "1729"
        }
      ],
      "default": "A slow forward dolly shot on a bright, sunlit day in a lush jungle ruin. A lone figure in nature-the…",
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "1734"
        }
      ],
      "default": 0,
