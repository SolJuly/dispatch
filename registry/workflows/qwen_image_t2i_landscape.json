{
  "schema": "p20.workflow/v1",
  "key": "qwen_image_t2i_landscape",
  "name": "Qwen-Image 文生图 1024×768 横版（复用同图）",
  "version": 1,
  "kind": "image",
  "engine": "comfyui",
  "graph": "workflows/qwen_image_t2i.api.json",
  "model": {
    "key": "qwen_image",
    "slots": {
      "unet": {
        "node": "unet",
        "input": "unet_name"
      },
      "clip": {
        "node": "clip",
        "input": "clip_name"
      },
      "vae": {
        "node": "vae",
        "input": "vae_name"
      }
    }
  },
  "params": {
    "prompt": {
      "type": "string",
      "required": true,
      "bindings": [
        {
          "node": "pos",
          "input": "text"
        }
      ]
    },
    "neg_prompt": {
      "type": "string",
      "default": "",
      "bindings": [
        {
          "node": "neg",
          "input": "text"
        }
      ]
    },
    "seed": {
      "type": "int",
      "required": true,
      "bindings": [
        {
          "node": "ks",
          "input": "seed"
        }
      ]
    },
    "width": {
      "type": "int",
      "default": 1024,
      "min": 256,
      "max": 2048,
      "multiple": 16,
      "bindings": [
        {
          "node": "lat",
          "input": "width"
        }
      ]
    },
    "height": {
      "type": "int",
      "default": 768,
      "min": 256,
      "max": 2048,
      "multiple": 16,
      "bindings": [
        {
          "node": "lat",
          "input": "height"
        }
      ]
    },
    "steps": {
      "type": "int",
      "default": 18,
      "min": 1,
      "max": 60,
      "bindings": [
        {
          "node": "ks",
          "input": "steps"
        }
      ]
    },
    "cfg": {
      "type": "float",
      "default": 2.5,
      "min": 0.0,
      "max": 30.0,
      "bindings": [
        {
          "node": "ks",
          "input": "cfg"
        }
      ]
    }
  },
  "output": {
    "node": "save",
    "input": "filename_prefix",
    "kind": "image",
    "ext": "png",
    "pick": [
      "images"
    ]
  },
  "expect_defaults": {
    "ext": "png",
    "min_bytes": 15000,
    "width": [
      1024
    ],
    "height": [
      768
    ],
    "black_ratio_max": 0.5
  },
  "limits": {
    "max_minutes": 30,
    "max_cost": 1.0
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "notes": "任务 5B 零代码控制实验：完全复用 qwen_image_t2i.api.json，只加这一份 JSON；核心代码 hash 前后必须一致。",
  "deprecated": true,
  "deprecated_reason": "P2.2 起由 zimage_turbo_t2i_hq 替换；仅保留供历史作业复现/回滚，控制台不再展示"
}
