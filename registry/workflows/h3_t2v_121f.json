{
 "schema": "p20.workflow/v1",
 "key": "h3_t2v_121f",
 "name": "文生视频 · MiniMax H3（121 帧）",
 "description": "纯文本生成 121 帧视频。输入：提示词；输出：MP4。（✅ 可使用）",
 "version": 1,
 "kind": "video",
 "engine": "comfyui",
 "graph": "workflows/h3_t2v_121f.api.json",
 "model": {
  "key": "h3",
  "slots": {
   "unet": {
    "node": "unet",
    "input": "unet_name"
   },
   "clip": {
    "node": "clip",
    "input": "clip_name"
   },
   "vae": {
    "node": "vae",
    "input": "vae_name"
   }
  }
 },
 "params": {
  "prompt": {
   "type": "string",
   "required": true,
   "bindings": [
    {
     "node": "cond",
     "input": "prompt"
    }
   ],
   "description": "正向提示词"
  },
  "neg_prompt": {
   "type": "string",
   "default": "",
   "bindings": [
    {
     "node": "neg",
     "input": "prompt"
    }
   ],
   "description": "负向提示词"
  },
  "seed": {
   "type": "int",
   "required": true,
   "bindings": [
    {
     "node": "ks",
     "input": "seed"
    }
   ]
  },
  "width": {
   "type": "int",
   "default": 768,
   "min": 256,
   "max": 1280,
   "multiple": 16,
   "bindings": [
    {
     "node": "cond",
     "input": "width"
    },
    {
     "node": "neg",
     "input": "width"
    }
   ]
  },
  "height": {
   "type": "int",
   "default": 512,
   "min": 256,
   "max": 1280,
   "multiple": 16,
   "bindings": [
    {
     "node": "cond",
     "input": "height"
    },
    {
     "node": "neg",
     "input": "height"
    }
   ]
  },
  "frames": {
   "type": "int",
   "default": 121,
   "min": 1,
   "max": 241,
   "bindings": [
    {
     "node": "cond",
     "input": "length"
    },
    {
     "node": "neg",
     "input": "length"
    }
   ],
   "description": "帧数（length）；121 帧 ≈ 5.17s @24fps"
  },
  "steps": {
   "type": "int",
   "default": 20,
   "min": 1,
   "max": 50,
   "bindings": [
    {
     "node": "ks",
     "input": "steps"
    }
   ]
  },
  "cfg": {
   "type": "float",
   "default": 1.0,
   "min": 0.0,
   "max": 30.0,
   "bindings": [
    {
     "node": "ks",
     "input": "cfg"
    }
   ]
  }
 },
 "output": {
  "node": "save",
  "input": "filename_prefix",
  "kind": "video",
  "ext": "mp4",
  "pick": [
   "videos",
   "gifs"
  ]
 },
 "expect_defaults": {
  "ext": "mp4",
  "min_bytes": 300000,
  "duration_s": [
   5.0,
   5.4
  ],
  "width": [
   768
  ],
  "height": [
   512
  ],
  "black_ratio_max": 0.5,
  "freeze": {
   "ratio_max": 0.2,
   "longest_max_s": 1.0
  }
 },
 "fps": 24,
 "limits": {
  "max_minutes": 45,
  "max_cost": 3.0
 },
 "required_gpu": [
  "4090_48G",
  "4090"
 ],
 "notes": "121 帧实测稳定；提示词与负提示词分别绑 cond/neg 两个 MiniMaxH3ImageToVideo 节点。"
}
