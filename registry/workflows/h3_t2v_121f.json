{
 "description": "纯文本生成 121 帧视频。输入：提示词；输出：MP4。（✅ 可使用）",
 "engine": "comfyui",
 "expect_defaults": {
  "black_ratio_max": 0.5,
  "duration_s": [
   5.0,
   5.4
  ],
  "ext": "mp4",
  "freeze": {
   "longest_max_s": 1.0,
   "ratio_max": 0.2
  },
  "height": [
   512
  ],
  "min_bytes": 100000,
  "width": [
   768
  ]
 },
 "fps": 24,
 "graph": "workflows/h3_t2v_121f.api.json",
 "key": "h3_t2v_121f",
 "kind": "video",
 "limits": {
  "max_cost": 3.0,
  "max_minutes": 45
 },
 "model": {
  "key": "h3",
  "slots": {
   "clip": {
    "input": "clip_name",
    "node": "clip"
   },
   "unet": {
    "input": "unet_name",
    "node": "unet"
   },
   "vae": {
    "input": "vae_name",
    "node": "vae"
   }
  }
 },
 "name": "文生视频 · MiniMax H3（121 帧）",
 "notes": "121 帧实测稳定；提示词与负提示词分别绑 cond/neg 两个 MiniMaxH3ImageToVideo 节点。",
 "output": {
  "ext": "mp4",
  "input": "filename_prefix",
  "kind": "video",
  "node": "save",
  "pick": [
   "videos",
   "gifs"
  ]
 },
 "params": {
  "cfg": {
   "bindings": [
    {
     "input": "cfg",
     "node": "ks"
    }
   ],
   "default": 2.0,
   "description": "提示词遵从度（CFG scale）。**这个工作流必须 >= 2.0**：H3 是 distilled 模型，cfg=1.0 时负向分支不参与计算，而 MinimaxH3ImageToVideo 的 negative 节点仍要吃一个 prompt，喂长文本会把条件张量带偏 → 解码出全黑视频（2026-11-15 实测：cfg=1.0 + 中文负向词 → 124 帧全黑，YMIN=YAVG=YMAX=16）。实测可用值 2.0；调高到 3-4 会更贴提示词但可能过饱和。",
   "max": 30.0,
   "min": 0.0,
   "type": "float"
  },
  "frames": {
   "bindings": [
    {
     "input": "length",
     "node": "cond"
    },
    {
     "input": "length",
     "node": "neg"
    }
   ],
   "default": 121,
   "description": "帧数（length）；121 帧 ≈ 5.17s @24fps",
   "max": 241,
   "min": 1,
   "type": "int"
  },
  "height": {
   "bindings": [
    {
     "input": "height",
     "node": "cond"
    },
    {
     "input": "height",
     "node": "neg"
    }
   ],
   "default": 512,
   "description": "输出高度（像素）。与宽度配套调整，保持原始素材的宽高比。",
   "max": 1280,
   "min": 256,
   "multiple": 16,
   "type": "int"
  },
  "neg_prompt": {
   "bindings": [
    {
     "input": "prompt",
     "node": "neg"
    }
   ],
   "default": "",
   "description": "负向提示词。**建议留空**：H3 的 cfg 在 1.0-2.0 区间对负向词的响应不稳定，喂长中文会把条件带偏（实测出全黑）。确实要用就写短英文，且先把 cfg 提到 3.0 以上。",
   "type": "string"
  },
  "prompt": {
   "bindings": [
    {
     "input": "prompt",
     "node": "cond"
    }
   ],
   "description": "正向提示词",
   "required": true,
   "type": "string"
  },
  "seed": {
   "bindings": [
    {
     "input": "seed",
     "node": "ks"
    }
   ],
   "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
   "required": true,
   "type": "int"
  },
  "steps": {
   "bindings": [
    {
     "input": "steps",
     "node": "ks"
    }
   ],
   "default": 20,
   "description": "采样步数。步数越多细节越好但线性变慢；蒸馏版模型（名字带 distilled / fast / 8 步）刻意用很少的步数换速度，不要随意调高。",
   "max": 50,
   "min": 1,
   "type": "int"
  },
  "width": {
   "bindings": [
    {
     "input": "width",
     "node": "cond"
    },
    {
     "input": "width",
     "node": "neg"
    }
   ],
   "default": 768,
   "description": "输出宽度（像素）。越大越清晰但越慢越贵；改完后高度要按同样的比例缩放，否则画面会被拉变形。",
   "max": 1280,
   "min": 256,
   "multiple": 16,
   "type": "int"
  }
 },
 "required_gpu": [
  "4090_48G",
  "4090"
 ],
 "schema": "p20.workflow/v1",
 "version": 1
}