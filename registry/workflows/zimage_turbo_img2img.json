{
  "schema": "p20.workflow/v1",
  "key": "zimage_turbo_img2img",
  "name": "Z-Image-Turbo 图生图（denoise 可控）",
  "version": 1,
  "kind": "image",
  "engine": "comfyui",
  "graph": "workflows/zimage_turbo_img2img.api.json",
  "model": {
    "key": "zimage_turbo",
    "slots": {
      "unet": {
        "node": "1",
        "input": "unet_name"
      },
      "clip": {
        "node": "3",
        "input": "clip_name"
      },
      "vae": {
        "node": "4",
        "input": "vae_name"
      }
    }
  },
  "params": {
    "prompt": {
      "type": "string",
      "required": true,
      "bindings": [
        {
          "node": "5",
          "input": "text"
        }
      ],
      "description": "正向提示词；蒸馏模型负面词无效"
    },
    "seed": {
      "type": "int",
      "required": true,
      "bindings": [
        {
          "node": "8",
          "input": "seed"
        }
      ]
    },
    "image": {
      "type": "image",
      "required": true,
      "bindings": [
        {
          "node": "10",
          "input": "image"
        }
      ],
      "description": "参考图；输出尺寸跟随输入"
    },
    "denoise": {
      "type": "float",
      "default": 0.55,
      "min": 0.2,
      "max": 1.0,
      "bindings": [
        {
          "node": "8",
          "input": "denoise"
        }
      ],
      "description": "0.3~0.6 保构图；越高改动越大"
    },
    "steps": {
      "type": "int",
      "default": 8,
      "min": 4,
      "max": 12,
      "bindings": [
        {
          "node": "8",
          "input": "steps"
        }
      ]
    },
    "cfg": {
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "bindings": [
        {
          "node": "8",
          "input": "cfg"
        }
      ]
    },
    "sampler": {
      "type": "enum",
      "default": "res_multistep",
      "values": [
        "res_multistep",
        "euler",
        "euler_ancestral",
        "dpmpp_2m",
        "uni_pc"
      ],
      "bindings": [
        {
          "node": "8",
          "input": "sampler_name"
        }
      ]
    },
    "scheduler": {
      "type": "enum",
      "default": "simple",
      "values": [
        "simple",
        "normal",
        "karras",
        "beta"
      ],
      "bindings": [
        {
          "node": "8",
          "input": "scheduler"
        }
      ]
    }
  },
  "output": {
    "node": "12",
    "input": "filename_prefix",
    "kind": "image",
    "ext": "png",
    "pick": [
      "images"
    ],
    "count": 1
  },
  "expect_defaults": {
    "ext": "png",
    "min_bytes": 20000,
    "images": 1,
    "black_ratio_max": 0.5
  },
  "limits": {
    "max_minutes": 20,
    "max_cost": 0.8
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "notes": "03 号图生图：LoadImage → VAEEncode → KSampler(denoise 0.55) → 单图；输出尺寸跟随输入。"
}
