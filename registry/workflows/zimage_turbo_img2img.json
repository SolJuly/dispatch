{
  "description": "以原图为底重绘，denoise 越低越接近原图。输入：图片 + 提示词；输出：1024 PNG。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "black_ratio_max": 0.5,
    "ext": "png",
    "images": 1,
    "min_bytes": 20000
  },
  "graph": "workflows/zimage_turbo_img2img.api.json",
  "key": "zimage_turbo_img2img",
  "kind": "image",
  "limits": {
    "max_cost": 0.8,
    "max_minutes": 20
  },
  "model": {
    "key": "zimage_turbo",
    "slots": {
      "clip": {
        "input": "clip_name",
        "node": "3"
      },
      "unet": {
        "input": "unet_name",
        "node": "1"
      },
      "vae": {
        "input": "vae_name",
        "node": "4"
      }
    }
  },
  "name": "图生图 · Z-Image-Turbo（denoise 可控）",
  "notes": "03 号图生图：LoadImage → VAEEncode → KSampler(denoise 0.55) → 单图；输出尺寸跟随输入。",
  "output": {
    "count": 1,
    "ext": "png",
    "input": "filename_prefix",
    "kind": "image",
    "node": "12",
    "pick": [
      "images"
    ]
  },
  "params": {
    "cfg": {
      "bindings": [
        {
          "input": "cfg",
          "node": "8"
        }
      ],
      "default": 1.0,
      "description": "提示词遵从度（CFG scale）。低（1-2）= 更自由、更贴合输入素材；高（7+）= 更严格按提示词来，但容易僵硬或过饱和。改图/动作迁移类建议留在低位。",
      "max": 2.0,
      "min": 0.5,
      "type": "float"
    },
    "denoise": {
      "bindings": [
        {
          "input": "denoise",
          "node": "8"
        }
      ],
      "default": 0.55,
      "description": "0.3~0.6 保构图；越高改动越大",
      "max": 1.0,
      "min": 0.2,
      "type": "float"
    },
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "10"
        }
      ],
      "description": "参考图；输出尺寸跟随输入",
      "required": true,
      "type": "image"
    },
    "prompt": {
      "bindings": [
        {
          "input": "text",
          "node": "5"
        }
      ],
      "description": "正向提示词；蒸馏模型负面词无效",
      "required": true,
      "type": "string"
    },
    "sampler": {
      "bindings": [
        {
          "input": "sampler_name",
          "node": "8"
        }
      ],
      "default": "res_multistep",
      "description": "采样器。不同采样器的风格倾向不同；没有特别理由就沿用默认值，换采样器可能让原本稳定的结果变得不可预期。",
      "type": "enum",
      "values": [
        "res_multistep",
        "euler",
        "euler_ancestral",
        "dpmpp_2m",
        "uni_pc"
      ]
    },
    "scheduler": {
      "bindings": [
        {
          "input": "scheduler",
          "node": "8"
        }
      ],
      "default": "simple",
      "description": "噪声调度器。与采样器配合决定去噪节奏；默认值通常已针对该模型调过。",
      "type": "enum",
      "values": [
        "simple",
        "normal",
        "karras",
        "beta"
      ]
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "8"
        }
      ],
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "required": true,
      "type": "int"
    },
    "steps": {
      "bindings": [
        {
          "input": "steps",
          "node": "8"
        }
      ],
      "default": 8,
      "description": "采样步数。步数越多细节越好但线性变慢；蒸馏版模型（名字带 distilled / fast / 8 步）刻意用很少的步数换速度，不要随意调高。",
      "max": 12,
      "min": 4,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
