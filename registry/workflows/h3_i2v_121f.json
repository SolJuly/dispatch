{
  "description": "单图驱动 121 帧（约 5 秒）视频。输入：首帧图 + 提示词；输出：MP4。（✅ 可使用）",
  "engine": "comfyui",
  "expect_defaults": {
    "black_ratio_max": 0.5,
    "duration_s": [
      5.0,
      5.4
    ],
    "ext": "mp4",
    "freeze": {
      "longest_max_s": 1.0,
      "ratio_max": 0.2
    },
    "height": [
      512
    ],
    "min_bytes": 300000,
    "width": [
      768
    ]
  },
  "fps": 24,
  "graph": "workflows/h3_i2v_121f.api.json",
  "key": "h3_i2v_121f",
  "kind": "video",
  "limits": {
    "max_cost": 3.0,
    "max_minutes": 45
  },
  "model": {
    "key": "h3",
    "slots": {
      "clip": {
        "input": "clip_name",
        "node": "clip"
      },
      "unet": {
        "input": "unet_name",
        "node": "unet"
      },
      "vae": {
        "input": "vae_name",
        "node": "vae"
      }
    }
  },
  "name": "图生视频 · MiniMax H3（121 帧）",
  "notes": "结构与 T2V 不同（多 LoadImage + first_frame 连线），兼容性单独判定，不继承 T2V 的 verified。",
  "output": {
    "ext": "mp4",
    "input": "filename_prefix",
    "kind": "video",
    "node": "save",
    "pick": [
      "videos",
      "gifs"
    ]
  },
  "params": {
    "cfg": {
      "bindings": [
        {
          "input": "cfg",
          "node": "ks"
        }
      ],
      "default": 1.0,
      "description": "提示词遵从度（CFG scale）。低（1-2）= 更自由、更贴合输入素材；高（7+）= 更严格按提示词来，但容易僵硬或过饱和。改图/动作迁移类建议留在低位。",
      "max": 30.0,
      "min": 0.0,
      "type": "float"
    },
    "frames": {
      "bindings": [
        {
          "input": "length",
          "node": "cond"
        },
        {
          "input": "length",
          "node": "neg"
        }
      ],
      "default": 121,
      "description": "生成帧数。视频类一般是 4n+1（如 81 / 121），因为模型按 4 帧一组处理。帧数直接决定时长和花费：帧数翻倍，耗时和钱基本也翻倍。",
      "max": 241,
      "min": 1,
      "type": "int"
    },
    "height": {
      "bindings": [
        {
          "input": "height",
          "node": "cond"
        },
        {
          "input": "height",
          "node": "neg"
        }
      ],
      "default": 512,
      "description": "输出高度（像素）。与宽度配套调整，保持原始素材的宽高比。",
      "max": 1280,
      "min": 256,
      "multiple": 16,
      "type": "int"
    },
    "image": {
      "bindings": [
        {
          "input": "image",
          "node": "img"
        }
      ],
      "description": "首帧文件名（需已上传到 ComfyUI/input）",
      "required": true,
      "type": "image"
    },
    "neg_prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "neg"
        }
      ],
      "default": "",
      "description": "负向提示词：不想出现的东西。默认值是一套通用的避坑词（防手部畸形、画面静止、糊、水印等），没有特殊需求就保持原样。",
      "type": "string"
    },
    "prompt": {
      "bindings": [
        {
          "input": "prompt",
          "node": "cond"
        }
      ],
      "description": "正向提示词：描述你想要的画面内容（主体、外貌、衣着、背景、风格）。写得具体比写得多更重要。",
      "required": true,
      "type": "string"
    },
    "seed": {
      "bindings": [
        {
          "input": "seed",
          "node": "ks"
        }
      ],
      "description": "随机种子。同一个种子 + 同一组参数能得到完全相同的结果；想复现某次出图就记下它。点「随机」换一个。",
      "required": true,
      "type": "int"
    },
    "steps": {
      "bindings": [
        {
          "input": "steps",
          "node": "ks"
        }
      ],
      "default": 20,
      "description": "采样步数。步数越多细节越好但线性变慢；蒸馏版模型（名字带 distilled / fast / 8 步）刻意用很少的步数换速度，不要随意调高。",
      "max": 50,
      "min": 1,
      "type": "int"
    },
    "width": {
      "bindings": [
        {
          "input": "width",
          "node": "cond"
        },
        {
          "input": "width",
          "node": "neg"
        }
      ],
      "default": 768,
      "description": "输出宽度（像素）。越大越清晰但越慢越贵；改完后高度要按同样的比例缩放，否则画面会被拉变形。",
      "max": 1280,
      "min": 256,
      "multiple": 16,
      "type": "int"
    }
  },
  "required_gpu": [
    "4090_48G",
    "4090"
  ],
  "schema": "p20.workflow/v1",
  "version": 1
}
