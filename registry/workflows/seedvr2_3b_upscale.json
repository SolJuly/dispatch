{
  "schema": "p20.workflow/v1",
  "key": "seedvr2_3b_upscale",
  "name": "SeedVR2 3B 图片还原放大（短边到 2K）",
  "version": 1,
  "kind": "image",
  "engine": "comfyui",
  "graph": "workflows/seedvr2_3b_upscale.api.json",
  "model": {
    "key": "seedvr2_3b",
    "slots": {
      "dit": {
        "node": "2",
        "input": "model"
      },
      "vae": {
        "node": "3",
        "input": "model"
      }
    }
  },
  "params": {
    "image": {
      "type": "image",
      "required": true,
      "bindings": [
        {
          "node": "1",
          "input": "image"
        }
      ],
      "description": "待放大的图片；输出按短边对齐 resolution，保持宽高比"
    },
    "resolution": {
      "type": "int",
      "default": 2048,
      "min": 512,
      "max": 4096,
      "bindings": [
        {
          "node": "4",
          "input": "resolution"
        }
      ],
      "description": "目标短边像素；2048 = 2K"
    },
    "seed": {
      "type": "int",
      "default": 42,
      "bindings": [
        {
          "node": "4",
          "input": "seed"
        }
      ]
    },
    "color_correction": {
      "type": "enum",
      "default": "lab",
      "values": [
        "lab",
        "wavelet",
        "wavelet_adaptive",
        "hsv",
        "adain",
        "none"
      ],
      "bindings": [
        {
          "node": "4",
          "input": "color_correction"
        }
      ]
    }
  },
  "output": {
    "node": "5",
    "input": "filename_prefix",
    "kind": "image",
    "ext": "png",
    "pick": [
      "images"
    ],
    "count": 1
  },
  "expect_defaults": {
    "ext": "png",
    "min_bytes": 20000,
    "images": 1,
    "black_ratio_max": 0.5
  },
  "limits": {
    "max_minutes": 20,
    "max_cost": 1.2
  },
  "required_gpu": [
    "4090",
    "4090_48G"
  ],
  "notes": "SeedVR2 3B 单图还原放大：LoadImage → SeedVR2VideoUpscaler(resolution=短边) → SaveImage；走 numz 自定义节点，绕开核心 UNETLoader 的 seedvr2 检测缺口。24G 4090 实测 1024→2048 通过。"
}
