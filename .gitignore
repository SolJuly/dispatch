# 凭据与运行时状态（绝不入库）
compshare/credentials.env
.compshare/
share/
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo

# 归档产物
reports/archive/

# 分享链接 token
.share_token
.htpasswd

# P1 运行态（job 产物与汇总）
reports/p1/jobs/
reports/p1/status.json

# 媒体产物与生成页（可由脚本重生成，不入库）
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.gif
reports/architecture.svg
reports/architecture.html
reports/lab/gallery*.html

# P1 运行态补充：锁文件 + 每 10 分钟被 cron 覆盖的风险报告
reports/p1/.job.lock
reports/p1/.submit.lock
reports/risk/

# P1 派生数据（可重建）
reports/p1/jobs/*/thumbs/

# PR 派生文件（不入库）
*.patch
*.diff

# P2 运行态（队列库是可删的，job 事实在 job.json）
reports/p2/*.db
reports/p2/*.db-wal
reports/p2/*.db-shm

# P2.0 Registry 派生索引（事实在 registry/*.json，可 p20ctl import 重建）
registry/registry.db
registry/registry.db-wal
registry/registry.db-shm

# P2.1 连测产物（44 张 PNG 约 48MB，已发布到 /pub/bench/，不入库）
reports/p2/p21/bench/

# P2.1 输入图副本（按内容哈希命名，可由原图重建）
reports/p2/p21/inputs/

# 部署运行时包（脚本生成，不入库）。锚定根目录：不锚定会连带忽略 web/dist，
# 而 web/dist 是手写前端源码（见 web/README.md），必须入库。
/dist/

# 前端：/ui/ 是纯原生手写代码，web/dist 里的文件**就是源码**，必须入库。
# 这里只忽略将来可能引入的 node 依赖与构建缓存。
web/node_modules/
web/.vite/
web/.cache/

# 一次性排障脚本（GPU 实例上的磁盘/存储探测，结论已写进报告，脚本本身无留存价值）
reports/p2/p21/disk-read.sh
reports/p2/p21/disk-test.sh
reports/p2/p21/disk-write.sh
reports/p2/p21/us3-check.sh

# 运行态快照：cron 每 10 分钟覆盖（tools/p2/status2.py），
# 入库会让工作区永远不干净，直接阻塞 scripts/repo-guard.sh 的部署守卫。
reports/p2/status2.json
