{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen/qwen_image_fp8_e4m3fn_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen25vl7b_std.safetensors",
      "type": "qwen_image"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_std_vae.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEG_PROMPT}}",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "lat": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": "{{BATCH_SIZE}}"
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "denoise": 1.0,
      "model": [
        "unet",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "lat",
        0
      ]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "{{OUTPUT_PREFIX}}",
      "images": [
        "dec",
        0
      ]
    }
  }
}
