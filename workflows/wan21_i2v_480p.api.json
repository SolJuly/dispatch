{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1/wan2.1_i2v_480p_14B_fp8_e4m3fn.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_int8_convrot.safetensors",
      "type": "wan"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "Wan2_1_VAE_bf16.safetensors"
    }
  },
  "cvis": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "img": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{FIRST_FRAME}}"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEG_PROMPT}}",
      "clip": [
        "clip",
        0
      ]
    }
  },
  "cvenc": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": [
        "cvis",
        0
      ],
      "image": [
        "img",
        0
      ],
      "crop": "none"
    }
  },
  "i2v": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "width": 832,
      "height": 480,
      "length": 49,
      "batch_size": 1,
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "start_image": [
        "img",
        0
      ],
      "clip_vision_output": [
        "cvenc",
        0
      ]
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "unet",
        0
      ],
      "positive": [
        "i2v",
        0
      ],
      "negative": [
        "i2v",
        1
      ],
      "latent_image": [
        "i2v",
        2
      ]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "vid": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "dec",
        0
      ],
      "fps": 16.0
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "vid",
        0
      ],
      "filename_prefix": "{{OUTPUT_PREFIX}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
