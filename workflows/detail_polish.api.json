{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "juggernautXL_v8Rundiffusion_V8.safetensors"
    }
  },
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{IMAGE}}",
      "upload": "image"
    }
  },
  "enc": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "load",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEG_PROMPT}}",
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "{{SAMPLER}}",
      "scheduler": "{{SCHEDULER}}",
      "denoise": "{{DENOISE}}",
      "model": [
        "ckpt",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "enc",
        0
      ]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    }
  },
  "up": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "{{UPSCALE_MODEL}}"
    }
  },
  "scale": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "up",
        0
      ],
      "image": [
        "dec",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "{{OUTPUT_PREFIX}}",
      "images": [
        "scale",
        0
      ]
    }
  }
}
